{
  "dependencies": {
    "@react-three/fiber": "^8.17.10",
    "@remotion/cli": "4.0.543",
    "@remotion/player": "4.0.543",
    "@remotion/three": "4.0.543",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.543",
    "three": "^0.170.0",
    "@remotion/captions": "4.0.543"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",

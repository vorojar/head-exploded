          "latin": "Foramen magnum"
        },
        {
          "x": 0.5,
          "y": -0.4,
          "z": -0.35,
          "label": "Jugular foramen",
          "latin": "Foramen jugulare"
        },
        {
          "x": 0.15,
          "y": -0.4,
          "z": -0.3,
          "label": "Hypoglossal canal",
          "latin": "Canalis hypoglossalis"
        }
      ]
    },

   "id": "intro",
   "start": 0,
   "end": 212,
   "bones": [],
   "labels": [],
   "text": "The skull is not one bone. Twenty-two bones lock together at sutures, and are pierced by foramina \u2014 doorways for nerves and vessels.",
   "mode": "intro",
   "camDir": [
    -0.55,
    0.39,
    0.74
   ],
   "lookAt": [
    0,
    0,
    0

          "y": 0.25,
          "z": -0.3,
          "label": "Squamous suture",
          "latin": "Sutura squamosa"
        }
      ]
    },
    {
      "id": "pterion",
      "start": 1187,
      "end": 1519,
      "bones": [],
      "labels": [],
      "text": "The pterion is where frontal, parietal, temporal, and sphenoid bones meet. This is a thin, vulnerable region of the lateral skull. A fracture may tear the underlying middle meningeal artery and cause an epidural hematoma.",
      "mode": "suture",
      "camDir": [
        -1,
        0.1,
        0.3
      ],
      "lookAt": [
        -0.62,
        0.12,
        0.55
      ],
      "dist": 3.0,
      "points": [
        {
          "x": -0.62,
          "y": 0.12,
          "z": 0.55,
          "label": "Pterion",
          "latin": "Pterion"
        },
        {
          "x": -0.55,
          "y": 0.05,
          "z": 0.5,
          "label": "Middle meningeal artery",
          "latin": "A. meningea media"
        }
      ]
    },
    {
